// The keyspace actor in isolation (no sockets, no AOF).
import std/time;
import aof;
import store;

fn start() -> Channel<store.Sv> {
    match (store.start("unused", false, aof.Fsync.Data)) {
        Result.Ok(sv) => sv,
        Result.Err(e) => panic(e),
    }
}

fn call(sv: Channel<store.Sv>, args: [string]) -> string {
    let reply: Channel<bytes> = Channel.bounded(1);
    send(sv, store.Sv.Cmd(args.map(fn(a: string) -> bytes { a.to_bytes() }), reply));
    match (recv(reply)) {
        Option.Some(b) => match (from_utf8(b)) {
            Result.Ok(s) => s,
            Result.Err(e) => panic(e),
        },
        Option.None => panic("store gone"),
    }
}

@test
fn a_stalled_subscriber_does_not_block_the_keyspace() {
    let sv = start();
    // A subscriber that never drains its (tiny) push buffer.
    let pushes: Channel<bytes> = Channel.bounded(1);
    let reply: Channel<bytes> = Channel.bounded(1);
    send(sv, store.Sv.Subscribe(1, "news", pushes, reply));
    recv(reply);
    assert_eq(call(sv, ["PUBLISH", "news", "one"]), ":1\r\n");
    // Buffer full: the message is dropped for that subscriber, the actor goes on.
    assert_eq(call(sv, ["PUBLISH", "news", "two"]), ":0\r\n");
    assert_eq(call(sv, ["PING"]), "+PONG\r\n");
    // A subscriber whose connection is gone (channel closed) is skipped too.
    close(pushes);
    assert_eq(call(sv, ["PUBLISH", "news", "three"]), ":0\r\n");
    assert_eq(call(sv, ["SET", "k", "v"]), "+OK\r\n");
}

@test
fn a_batch_answers_every_command_in_order() {
    let sv = start();
    let reply: Channel<[bytes]> = Channel.bounded(1);
    let cmds = [["SET", "a", "1"], ["INCR", "a"], ["GET", "a"], ["BOGUS"]];
    send(
        sv,
        store.Sv.Batch(
            cmds.map(fn(c: [string]) -> [bytes] { c.map(fn(a: string) -> bytes { a.to_bytes() }) }),
            reply
        )
    );
    let got = from_utf8(bytes_concat(recv(reply).expect("store gone"))).expect("utf8");
    assert_eq(got, "+OK\r\n:2\r\n$1\r\n2\r\n-ERR unknown command 'BOGUS'\r\n");
}

@test
fn the_sweep_drops_only_expired_keys() {
    let sv = start();
    call(sv, ["SET", "gone", "x", "PX", "30"]);
    call(sv, ["SET", "kept", "x", "PX", "60000"]);
    call(sv, ["SET", "plain", "x"]);
    // A TTL that a later plain SET clears must not be swept.
    call(sv, ["SET", "reset", "x", "PX", "30"]);
    call(sv, ["SET", "reset", "y"]);
    time.sleep(80);
    send(sv, store.Sv.Tick);
    // DBSIZE does not expire lazily: only the sweep can have removed "gone".
    assert_eq(call(sv, ["DBSIZE"]), ":3\r\n");
    assert_eq(call(sv, ["GET", "reset"]), "$1\r\ny\r\n");
    assert_eq(call(sv, ["TTL", "reset"]), ":-1\r\n");
}

@test
fn a_batch_of_reads_returns_every_value_whole() {
    let sv = start();
    // Bigger than JOIN_IN_ACTOR: the chunks come back unjoined.
    let big = "v".repeat(3000);
    call(sv, ["SET", "big", big]);
    call(sv, ["SET", "small", "s"]);
    let reply: Channel<[bytes]> = Channel.bounded(1);
    send(sv, store.Sv.Batch([[b"get", b"big"], [b"GET", b"none"], [b"GET", b"small"]], reply));
    let got = from_utf8(bytes_concat(recv(reply).expect("store gone"))).expect("utf8");
    assert_eq(got, "$3000\r\n" + big + "\r\n$-1\r\n$1\r\ns\r\n");
}

@test
fn out_of_range_expiries_and_increments_are_errors() {
    let sv = start();
    let max = "9223372036854775807";
    assert_eq(call(sv, ["SET", "a", "v", "EX", max]).starts_with("-ERR"), true);
    assert_eq(call(sv, ["SET", "a", "v", "PX", "0"]).starts_with("-ERR"), true);
    assert_eq(call(sv, ["SET", "n", max]), "+OK\r\n");
    assert_eq(call(sv, ["INCR", "n"]).starts_with("-ERR"), true);
    assert_eq(call(sv, ["SET", "m", "-" + max]), "+OK\r\n");
    assert_eq(call(sv, ["DECR", "m"]), ":-9223372036854775808\r\n");
    assert_eq(call(sv, ["DECR", "m"]).starts_with("-ERR"), true);
    assert_eq(call(sv, ["PEXPIRE", "n", max]).starts_with("-ERR"), true);
    // A deadline in the past expires the key; it does not make it permanent.
    assert_eq(call(sv, ["PEXPIREAT", "n", "-5"]), ":1\r\n");
    assert_eq(call(sv, ["GET", "n"]), "$-1\r\n");
    assert_eq(call(sv, ["PING"]), "+PONG\r\n");
}

@test
fn keys_globs_without_backtracking() {
    let sv = start();
    call(sv, ["SET", "a".repeat(40), "v"]);
    call(sv, ["SET", "hello", "v"]);
    let t0 = time.now();
    assert_eq(call(sv, ["KEYS", "*a".repeat(12) + "b"]), "*0\r\n");
    assert_eq(time.now() - t0 < 500, true);
    assert_eq(call(sv, ["KEYS", "h?l*o"]), "*1\r\n$5\r\nhello\r\n");
    assert_eq(call(sv, ["KEYS", "*l"]), "*0\r\n");
    assert_eq(call(sv, ["KEYS", "**"]).starts_with("*2"), true);
}
