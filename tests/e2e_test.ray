// End-to-end through net/redis (the compat target besides redis-cli): data
// commands, expiry, and AOF durability across a broker restart. One @test
// (the runner leaves zombie listeners between tests).
import std/fs;
import std/net;
import std/time;
import net/redis;
import aof;
import store;
import server;

// Boots a store over dir plus a server on an ephemeral port; returns the port.
fn boot(dir: string) -> int {
    let sv = match (store.start(dir, true, aof.Fsync.Data)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    match (server.start("127.0.0.1", 0, sv)) {
        Result.Ok(p) => p,
        Result.Err(e) => panic(e),
    }
}

fn conn(port: int) -> redis.Conn {
    match (redis.connect("127.0.0.1", port)) {
        Result.Ok(c) => c,
        Result.Err(e) => panic(e),
    }
}

fn cmd(c: redis.Conn, args: [string]) -> string {
    match (redis.command(c, args)) {
        Result.Ok(r) => redis.reply_str(r),
        Result.Err(e) => panic(join(args, " ") + ": " + e),
    }
}

@test
fn raykv_end_to_end() {
    let dir = match (fs.make_temp_dir("raykv_e2e")) {
        Result.Ok(d) => d,
        Result.Err(e) => panic(e),
    };
    let port = boot(dir);
    let c = conn(port);
    assert_eq(cmd(c, ["PING"]), "PONG");
    assert_eq(cmd(c, ["SET", "saludo", "hola"]), "OK");
    assert_eq(cmd(c, ["GET", "saludo"]), "hola");
    assert_eq(cmd(c, ["GET", "nada"]), "(nil)");
    assert_eq(cmd(c, ["INCR", "visitas"]), "1");
    assert_eq(cmd(c, ["INCRBY", "visitas", "10"]), "11");
    assert_eq(cmd(c, ["INCR", "saludo"]), "(error) ERR value is not an integer or out of range");
    assert_eq(cmd(c, ["SET", "fugaz", "x", "PX", "150"]), "OK");
    assert_eq(cmd(c, ["EXISTS", "fugaz", "saludo", "nada"]), "2");
    time.sleep(250);
    assert_eq(cmd(c, ["GET", "fugaz"]), "(nil)");
    assert_eq(cmd(c, ["SET", "nx1", "a", "NX"]), "OK");
    assert_eq(cmd(c, ["SET", "nx1", "b", "NX"]), "(nil)");
    assert_eq(cmd(c, ["GET", "nx1"]), "a");
    assert_eq(cmd(c, ["TTL", "saludo"]), "-1");
    assert_eq(cmd(c, ["TTL", "no-such"]), "-2");
    assert_eq(cmd(c, ["DEL", "nx1", "no-such"]), "1");
    assert_eq(cmd(c, ["KEYS", "salu*"]), "[saludo]");
    assert_eq(cmd(c, ["TYPE", "saludo"]), "string");
    redis.close_conn(c);

    // Pipelining over a raw socket: one write with several commands (a
    // SUBSCRIBE in the middle splits the batch) gets every reply, in order.
    let raw = match (net.tcp_connect("127.0.0.1", port)) {
        Result.Ok(h) => h,
        Result.Err(e) => panic(e),
    };
    net.socket_write(
        raw,
        "*3\r\n$3\r\nSET\r\n$2\r\np1\r\n$1\r\na\r\n*2\r\n$3\r\nGET\r\n$2\r\np1\r\n"
            + "*2\r\n$9\r\nSUBSCRIBE\r\n$2\r\nch\r\n*1\r\n$4\r\nQUIT\r\n"
    );
    let want = "+OK\r\n$1\r\na\r\n*3\r\n$9\r\nsubscribe\r\n$2\r\nch\r\n:1\r\n+OK\r\n";
    var got = b"";
    while (got.len() < want.len()) {
        match (net.socket_read_bytes(raw)) {
            Result.Ok(chunk) => {
                if (chunk.len() == 0) {
                    break;
                }
                got = got + chunk;
            },
            Result.Err(e) => break,
        }
    }
    assert_eq(from_utf8(got).unwrap_or("<binary>"), want);
    close(raw);

    // Durability: a second store over the same dir (fresh port) sees the data.
    let c2 = conn(boot(dir));
    assert_eq(cmd(c2, ["GET", "saludo"]), "hola");
    assert_eq(cmd(c2, ["GET", "visitas"]), "11");
    assert_eq(cmd(c2, ["GET", "fugaz"]), "(nil)");
    assert_eq(cmd(c2, ["GET", "p1"]), "a");
    assert_eq(cmd(c2, ["DBSIZE"]), "3");
    redis.close_conn(c2);
    fs.remove_all(dir);
}
