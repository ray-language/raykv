// raykv — the TCP front: one fiber per connection, incremental RESP parsing,
// commands serialized through the store actor (like Redis, single-threaded
// where it counts). A subscribed connection gains a writer fiber fed by its
// pub/sub channel while the reader keeps parsing.
import std/net;
import resp;
import store;

pub fn start(bind: string, port: int, sv: Channel<store.Sv>) -> Result<int, string> {
    let listener = net.tcp_listen(bind, port)?;
    let actual = net.local_port(listener);
    spawn(fn() {
        var next_id = 1;
        while (true) {
            match (net.tcp_accept(listener)) {
                Result.Err(e) => {
                    return;
                },
                Result.Ok(h) => {
                    let conn_id = next_id;
                    next_id = next_id + 1;
                    spawn(fn() {
                        serve_conn(h, conn_id, sv);
                    });
                },
            }
        }
    });
    Result.Ok(actual)
}

fn upper(b: bytes) -> string {
    match (from_utf8(b)) {
        Result.Ok(s) => s.to_upper(),
        Result.Err(e) => "",
    }
}

fn arg_str(args: [bytes], i: int) -> string {
    from_utf8(args[i]).unwrap_or("")
}

// Per-connection state shared by the read loop and the command dispatcher.
struct Conn {
    h: int,
    id: int,
    sv: Channel<store.Sv>,
    reply: Channel<bytes>,
    // The pub/sub out channel exists from the start; a writer fiber drains it
    // only once the connection subscribes.
    pushes: Channel<bytes>,
    writer_running: bool,
}

fn serve_conn(h: int, conn_id: int, sv: Channel<store.Sv>) {
    // Request/response over a long-lived connection: no Nagle delay on the
    // small replies, and OS keepalive probes reap clients that vanished.
    net.set_nodelay(h, true);
    net.set_keepalive(h, true);
    let c = Conn {
        h: h,
        id: conn_id,
        sv: sv,
        reply: Channel.bounded(1),
        pushes: Channel.bounded(64),
        writer_running: false
    };
    var buf = b"";
    var alive = true;
    while (alive) {
        match (net.socket_read_bytes(h)) {
            Result.Err(e) => {
                break;
            },
            Result.Ok(chunk) => {
                if (chunk.len() == 0) {
                    break;
                }
                buf = buf + chunk;
                // Every complete command in the buffer (pipelining).
                while (alive) {
                    match (resp.parse(buf)) {
                        resp.Parsed.NeedMore => {
                            break;
                        },
                        resp.Parsed.Bad(e) => {
                            net.socket_write_bytes(h, resp.error(e));
                            alive = false;
                        },
                        resp.Parsed.Cmd(args, used) => {
                            buf = buf.sub_bytes(used, buf.len());
                            if (args.len() > 0) {
                                alive = dispatch(c, args);
                            }
                        },
                    }
                }
            },
        }
    }
    send(sv, store.Sv.Gone(conn_id));
    close(c.pushes);
    close(h);
}

// Runs one command and writes its reply; false when the connection must end.
fn dispatch(c: Conn, args: [bytes]) -> bool {
    let cmd = upper(args[0]);
    var out = b"";
    if (cmd == "SUBSCRIBE" && args.len() >= 2) {
        for i in 1..args.len() {
            send(c.sv, store.Sv.Subscribe(c.id, arg_str(args, i), c.pushes, c.reply));
            if let Option.Some(r) = recv(c.reply) {
                out = out + r;
            }
        }
        if (!c.writer_running) {
            c.writer_running = true;
            let h = c.h;
            let pushes = c.pushes;
            spawn(fn() {
                while (true) {
                    match (recv(pushes)) {
                        Option.Some(frame) => {
                            if let Result.Err(e) = net.socket_write_bytes(h, frame) {
                                break;
                            }
                        },
                        Option.None => {
                            break;
                        },
                    }
                }
            });
        }
    } else if (cmd == "UNSUBSCRIBE" && args.len() >= 2) {
        for i in 1..args.len() {
            send(c.sv, store.Sv.Unsubscribe(c.id, arg_str(args, i), c.reply));
            if let Option.Some(r) = recv(c.reply) {
                out = out + r;
            }
        }
    } else if (cmd == "QUIT") {
        net.socket_write_bytes(c.h, resp.simple("OK"));
        return false;
    } else {
        send(c.sv, store.Sv.Cmd(args, c.reply));
        match (recv(c.reply)) {
            Option.Some(r) => {
                out = r;
            },
            Option.None => {
                return false;
            },
        }
    }
    if (out.len() > 0) {
        if let Result.Err(e) = net.socket_write_bytes(c.h, out) {
            return false;
        }
    }
    true
}
