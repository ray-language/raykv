// raykv — the append-only file: RESP-encoded logical commands, replayed with
// the same incremental parser the server uses. A torn tail (crash mid-append)
// simply fails to parse and is discarded. Since raylang M115.1 the append is
// BINARY (fs.write_bytes: values are arbitrary bytes, not UTF-8-only) and
// fsync'd (fs.sync: durable across power loss, not just a process crash).
import std/fs;
import resp;

pub struct Aof {
    handle: int,
    enabled: bool,
}

pub fn disabled() -> Aof {
    Aof { handle: 0 - 1, enabled: false }
}

pub fn append(a: Aof, args: [bytes]) {
    if (!a.enabled) {
        return;
    }
    // fs.write_bytes (raylang M115.1): el frame RESP va en BYTES — los valores binarios
    // (\x00, \xff, no-UTF-8) persisten intactos. fs.sync: durable ante corte de luz.
    match (fs.write_bytes(a.handle, resp.encode_command(args))) {
        Result.Ok(_n) => {
            let _ = fs.sync(a.handle);
        },
        Result.Err(_e) => { },
    }
}

pub fn replay(path: string) -> [[bytes]] {
    var out: [[bytes]] = [];
    if (!fs.exists(path)) {
        return out;
    }
    match (fs.read_file_bytes(path)) {
        Result.Err(e) => out,
        Result.Ok(all) => {
            var buf = all;
            var more = true;
            while (more) {
                match (resp.parse(buf)) {
                    resp.Parsed.Cmd(args, used) => {
                        out.push(args);
                        buf = buf.sub_bytes(used, buf.len());
                    },
                    resp.Parsed.NeedMore => {
                        more = false;
                    },
                    resp.Parsed.Bad(e) => {
                        more = false;
                    },
                }
            }
            out
        },
    }
}

// Rewrites the AOF to the live dataset (SET + PEXPIREAT pairs), renames it
// into place, and returns the fresh append handle.
pub fn rewrite_and_open(path: string, commands: [[bytes]]) -> Result<Aof, string> {
    let tmp = path + ".tmp";
    var content = b"";
    for cmd in commands {
        content = content + resp.encode_command(cmd);
    }
    fs.write_file_bytes(tmp, content)?;
    fs.rename(tmp, path)?;
    let h = fs.open(path, "a")?;
    Result.Ok(Aof { handle: h, enabled: true })
}
