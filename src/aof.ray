// raykv — the append-only file: RESP-encoded logical commands, replayed with
// the same incremental parser the server uses. A torn tail (crash mid-append)
// simply fails to parse and is discarded. Since raylang M115.1 the append is
// BINARY (fs.write_bytes: values are arbitrary bytes, not UTF-8-only). Each
// append is flushed with fs.sync_data (fdatasync: survives a process or OS
// crash; on macOS/APFS it skips the drive-cache flush, so a power cut can lose
// the last appends). The rewrite is the checkpoint: it goes through a full
// fs.sync before the rename.
import std/fs;
import resp;

pub struct Aof {
    handle: int,
    enabled: bool,
}

pub fn disabled() -> Aof {
    Aof { handle: -1, enabled: false }
}

pub fn append(a: Aof, args: [bytes]) {
    if (!a.enabled) {
        return;
    }
    // The RESP frame goes as BYTES, so binary values (\x00, \xff, non-UTF-8)
    // persist intact. sync_data per append: fs.sync here capped writes at ~240/s.
    match (fs.write_bytes(a.handle, resp.encode_command(args))) {
        Result.Ok(_n) => {
            let _ = fs.sync_data(a.handle);
        },
        Result.Err(_e) => { },
    }
}

pub fn replay(path: string) -> [[bytes]] {
    var out: [[bytes]] = [];
    if (!fs.exists(path)) {
        return out;
    }
    match (fs.read_file_bytes(path)) {
        Result.Err(e) => out,
        Result.Ok(all) => {
            var buf = all;
            while (true) {
                match (resp.parse(buf)) {
                    resp.Parsed.Cmd(args, used) => {
                        out.push(args);
                        buf = buf.sub_bytes(used, buf.len());
                    },
                    // NeedMore/Bad: a torn tail from a crash mid-append.
                    _ => {
                        break;
                    },
                }
            }
            out
        },
    }
}

// Rewrites the AOF to the live dataset (SET + PEXPIREAT pairs), renames it
// into place, and returns the fresh append handle.
pub fn rewrite_and_open(path: string, commands: [[bytes]]) -> Result<Aof, string> {
    let tmp = path + ".tmp";
    var content = b"";
    for cmd in commands {
        content = content + resp.encode_command(cmd);
    }
    // fsync the rewrite BEFORE the atomic rename: otherwise a power loss right
    // after it can leave the only AOF empty or partial.
    write_synced(tmp, content)?;
    fs.rename(tmp, path)?;
    let h = fs.open(path, "a")?;
    Result.Ok(Aof { handle: h, enabled: true })
}

// write_file_bytes + fsync, closing the handle on every path.
fn write_synced(path: string, content: bytes) -> Result<int, string> {
    let h = fs.open(path, "w")?;
    let r = write_then_sync(h, content);
    close(h);
    r
}

fn write_then_sync(h: int, content: bytes) -> Result<int, string> {
    let n = fs.write_bytes(h, content)?;
    fs.sync(h)?;
    Result.Ok(n)
}
