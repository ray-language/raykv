// raykv — RESP2: an incremental, binary-safe parser and the reply encoders.
//
// The parser consumes from a growing byte buffer and yields one command
// (array of bulk strings, each raw bytes) per call — or NeedMore when the
// frame is torn across TCP chunks. Inline commands ("PING\r\n", what a bare
// telnet/redis-cli sends before RESP) are supported too.

pub enum Parsed {
    Cmd([bytes], int),
    NeedMore,
    Bad(string),
}

// bytes.index_of_from (raylang 1.27.13): search from `start` without copying
// the tail with sub_bytes or scanning byte by byte.
fn find_crlf(buf: bytes, start: int) -> Option<int> {
    buf.index_of_from(b"\r\n", start)
}

// The longest *N / $N header line accepted: a sign and 19 digits.
const MAX_LEN_LINE: int = 20;

const INT_MAX: int = 9223372036854775807;

// Digits outside the int range are None, not an overflow: the caller turns
// them into an error reply.
fn parse_int_bytes(buf: bytes, start: int, end: int) -> Option<int> {
    var v = 0;
    var i = start;
    var neg = false;
    if (i < end && buf[i] == 45) {
        neg = true;
        i = i + 1;
    }
    if (i >= end) {
        return Option.None;
    }
    while (i < end) {
        let d = buf[i];
        if (d < 48 || d > 57) {
            return Option.None;
        }
        if (v > (INT_MAX - (d - 48)) / 10) {
            return Option.None;
        }
        v = v * 10 + (d - 48);
        i = i + 1;
    }
    if (neg) { Option.Some(-v) } else { Option.Some(v) }
}

// A web page can POST to this port and, since inline commands are accepted,
// the lines of its body would run as commands (Redis "Cross Protocol
// Scripting", fixed in 3.2.7). An inline line starting with POST or Host:
// is an HTTP request, never a command: the connection is closed.
fn looks_like_http(line: string) -> bool {
    let l = line.trim().to_lower();
    l.starts_with("post ") || l.starts_with("host:")
}

// One command from buf[0..): Cmd(args, consumed) | NeedMore | Bad.
pub fn parse(buf: bytes) -> Parsed {
    parse_at(buf, 0)
}

// One command from buf[start..), without copying the tail: Cmd(args, consumed
// from start) | NeedMore | Bad. Lets a reader walk a big buffer (the AOF
// replay) by offset instead of re-slicing it after every command.
pub fn parse_at(buf: bytes, start: int) -> Parsed {
    if (buf.len() <= start) {
        return Parsed.NeedMore;
    }
    if (buf[start] != 42) {
        // Inline command: a single line, split on spaces.
        match (find_crlf(buf, start)) {
            Option.None => {
                if (buf.len() - start > 65536) {
                    return Parsed.Bad("inline command too long");
                }
                Parsed.NeedMore
            },
            Option.Some(e) => {
                match (from_utf8(buf.sub_bytes(start, e))) {
                    Result.Err(err) => Parsed.Bad("invalid inline command"),
                    Result.Ok(line) => {
                        if (looks_like_http(line)) {
                            return Parsed.Bad("cross-protocol request (HTTP), closing");
                        }
                        var out: [bytes] = [];
                        for part in line.split(" ") {
                            if (part.trim() != "") {
                                out.push(part.trim().to_bytes());
                            }
                        }
                        Parsed.Cmd(out, e + 2 - start)
                    },
                }
            },
        }
    } else {
        let head_end = match (find_crlf(buf, start + 1)) {
            Option.Some(e) => e,
            Option.None => {
                if (buf.len() - start > MAX_LEN_LINE + 1) {
                    return Parsed.Bad("invalid multibulk length");
                }
                return Parsed.NeedMore;
            },
        };
        if (head_end - start > MAX_LEN_LINE + 1) {
            return Parsed.Bad("invalid multibulk length");
        }
        let n = match (parse_int_bytes(buf, start + 1, head_end)) {
            Option.Some(v) => v,
            Option.None => {
                return Parsed.Bad("invalid multibulk length");
            },
        };
        if (n < 0 || n > 1024) {
            return Parsed.Bad("invalid multibulk length");
        }
        var pos = head_end + 2;
        var out: [bytes] = [];
        var i = 0;
        while (i < n) {
            if (pos >= buf.len() || buf[pos] != 36) {
                if (pos >= buf.len()) {
                    return Parsed.NeedMore;
                }
                return Parsed.Bad("expected '$'");
            }
            let lend = match (find_crlf(buf, pos + 1)) {
                Option.Some(e) => e,
                Option.None => {
                    if (buf.len() - pos > MAX_LEN_LINE + 1) {
                        return Parsed.Bad("invalid bulk length");
                    }
                    return Parsed.NeedMore;
                },
            };
            if (lend - pos > MAX_LEN_LINE + 1) {
                return Parsed.Bad("invalid bulk length");
            }
            let blen = match (parse_int_bytes(buf, pos + 1, lend)) {
                Option.Some(v) => v,
                Option.None => {
                    return Parsed.Bad("invalid bulk length");
                },
            };
            if (blen < 0 || blen > 536870912) {
                return Parsed.Bad("invalid bulk length");
            }
            let dstart = lend + 2;
            if (dstart + blen + 2 > buf.len()) {
                return Parsed.NeedMore;
            }
            out.push(buf.sub_bytes(dstart, dstart + blen));
            pos = dstart + blen + 2;
            i = i + 1;
        }
        Parsed.Cmd(out, pos - start)
    }
}

// --- Encoders ---------------------------------------------------------------

pub const OK: bytes = b"+OK\r\n";

pub const CRLF: bytes = b"\r\n";

// "$<n>\r\n", the header of a bulk string of n bytes.
pub fn bulk_header(n: int) -> bytes {
    ("$" + to_string(n) + "\r\n").to_bytes()
}

// A status or error line must stay one line: CR and LF in the text (an
// echoed command name, say) would let it forge a second reply.
fn one_line(s: string) -> string {
    s.replace("\r", " ").replace("\n", " ")
}

pub fn simple(s: string) -> bytes {
    ("+" + one_line(s) + "\r\n").to_bytes()
}

pub fn error(s: string) -> bytes {
    ("-ERR " + one_line(s) + "\r\n").to_bytes()
}

pub fn integer(n: int) -> bytes {
    (":" + to_string(n) + "\r\n").to_bytes()
}

pub fn nil() -> bytes {
    b"$-1\r\n"
}

pub fn bulk(b: bytes) -> bytes {
    bulk_header(b.len()) + b + CRLF
}

pub fn bulk_str(s: string) -> bytes {
    bulk(s.to_bytes())
}

pub fn array_header(n: int) -> bytes {
    ("*" + to_string(n) + "\r\n").to_bytes()
}

pub fn array_of(items: [bytes]) -> bytes {
    var out = array_header(items.len());
    for it in items {
        out = out + bulk(it);
    }
    out
}

// The full command back in wire form (what the AOF stores).
pub fn encode_command(args: [bytes]) -> bytes {
    array_of(args)
}
